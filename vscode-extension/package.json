{
  "name": "javelin-ai-assistant",
  "displayName": "Javelin AI Assistant",
  "description": "A fully self-hosted, local-first AI coding assistant for VS Code. Uses your Javelin model through Ollama; no cloud AI API is required.",
  "publisher": "javelin-ai-private",
  "version": "1.2.1",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/javelin-ai/javelin-ai-assistant.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:javelin.assistant",
    "onCommand:javelin.openAssistant"
  ],
  "contributes": {
    "commands": [
      {
        "command": "javelin.openAssistant",
        "title": "Open Assistant",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openIdeDashboard",
        "title": "Open Javelin IDE",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openAiWorkspace",
        "title": "Open AI Workspace",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.projectSummary",
        "title": "Project Summary",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openExplorer",
        "title": "Open Explorer",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openTerminal",
        "title": "Open Terminal",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openProblems",
        "title": "Open Problems",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openExtensions",
        "title": "Open Extensions",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.runProjectChecks",
        "title": "Run Project Checks",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.checkForUpdates",
        "title": "Check for Updates",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.setUpdateToken",
        "title": "Configure Private Update Access",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.runJavelinTask",
        "title": "Run Javelin Task…",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.runAgentTask",
        "title": "Run Agent Task…",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.openCodingAgent",
        "title": "Open Coding Agent",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.stopAgent",
        "title": "Stop Agent",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.revertAllChanges",
        "title": "Revert All Changes (undo last run)",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.acceptAllChanges",
        "title": "Accept All Changes (keep last run)",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.revertToLastMessage",
        "title": "Revert to My Last Message (undo chat and files)",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.restoreCheckpoint",
        "title": "Restore Checkpoint…",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.selectProvider",
        "title": "Select Model Provider",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.explainCode",
        "title": "Explain Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.refactorCode",
        "title": "Refactor Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.findBugs",
        "title": "Find Bugs in Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.generateTests",
        "title": "Generate Tests for Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.generateDocs",
        "title": "Generate Documentation for Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.codeReview",
        "title": "Code Review Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.optimizeCode",
        "title": "Optimize Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.securityScan",
        "title": "Security Scan Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.addComments",
        "title": "Add Comments to Selected Code",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.quickAction",
        "title": "Quick Action…",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.saveSnippet",
        "title": "Save Code Snippet",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.loadSnippet",
        "title": "Load Code Snippet",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.exportConversation",
        "title": "Export Conversation",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.findTODOs",
        "title": "Find TODOs in Project",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.checkDependencies",
        "title": "Check for Outdated Dependencies",
        "category": "Javelin AI"
      },
      {
        "command": "javelin.workspaceStats",
        "title": "Show Workspace Statistics",
        "category": "Javelin AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "javelin.askAboutSelection",
          "when": "editorHasSelection",
          "group": "javelin@1"
        },
        {
          "command": "javelin.explainCode",
          "when": "editorHasSelection",
          "group": "javelin@2"
        },
        {
          "command": "javelin.refactorCode",
          "when": "editorHasSelection",
          "group": "javelin@3"
        },
        {
          "command": "javelin.findBugs",
          "when": "editorHasSelection",
          "group": "javelin@4"
        },
        {
          "command": "javelin.generateTests",
          "when": "editorHasSelection",
          "group": "javelin@5"
        },
        {
          "command": "javelin.quickAction",
          "when": "editorHasSelection",
          "group": "javelin@6"
        }
      ],
      "commandPalette": [
        {
          "command": "javelin.openAssistant"
        },
        {
          "command": "javelin.openIdeDashboard"
        },
        {
          "command": "javelin.openAiWorkspace"
        },
        {
          "command": "javelin.projectSummary"
        },
        {
          "command": "javelin.openExplorer"
        },
        {
          "command": "javelin.openTerminal"
        },
        {
          "command": "javelin.openProblems"
        },
        {
          "command": "javelin.openExtensions"
        },
        {
          "command": "javelin.runProjectChecks"
        },
        {
          "command": "javelin.checkForUpdates"
        },
        {
          "command": "javelin.setUpdateToken"
        },
        {
          "command": "javelin.quickAction"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "javelin-sidebar",
          "title": "Javelin AI",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "javelin-sidebar": [
        {
          "type": "webview",
          "id": "javelin.assistant",
          "name": "AI Assistant",
          "contextualTitle": "Javelin AI Assistant",
          "icon": "$(robot)"
        },
        {
          "type": "tree",
          "id": "javelin.workspaceOverview",
          "name": "Workspace",
          "contextualTitle": "Javelin Workspace",
          "icon": "$(folder-library)"
        },
        {
          "type": "tree",
          "id": "javelin.memoryOverview",
          "name": "Memory",
          "contextualTitle": "Javelin Memory",
          "icon": "$(history)"
        }
      ]
    },
    "configuration": {
      "title": "Javelin AI",
      "properties": {
        "javelin.provider": {
          "type": "string",
          "default": "javelin",
          "enum": [
            "javelin",
            "local"
          ],
          "enumDescriptions": [
            "Your Javelin model served locally through Ollama (no cloud API or key)",
            "Keyless local model via Ollama — code never leaves your machine"
          ],
          "markdownDescription": "Where the model runs. The default **Javelin** provider uses your local Javelin model through Ollama. Inference stays on this machine; no cloud AI API or key is used.",
          "order": 0
        },
        "javelin.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional local Ollama endpoint override. Javelin only accepts localhost on port 11434.",
          "order": 1
        },
        "javelin.model": {
          "type": "string",
          "default": "javelin-coder:latest",
          "markdownDescription": "Model tag served by your local Ollama installation.",
          "order": 2
        },
        "javelin.autonomy": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "auto-edit",
            "full"
          ],
            "enumDescriptions": [
            "Ask before every file change and every non-allowlisted command.",
            "Apply edits without asking; deleting a file and unusual commands still confirm first.",
            "Do everything unattended — plan, edit, delete, run. Only catastrophic commands stay blocked."
          ],
          "markdownDescription": "How much Javelin may do without stopping to ask. **Auto-edit** applies code edits without prompting, but still confirms **file deletions** and unusual commands — so a delete can never happen just because you turned on fast editing. **Full** lets the agent complete a whole task end to end, including deleting files, taking a checkpoint at the start instead of pausing. Catastrophic commands (`rm -rf /`, disk formatting, etc.) are always refused.",
          "order": 4
        },
        "javelin.agentAutoApproveSafeCommands": {
          "type": "boolean",
          "default": true,
          "description": "Run test/build/lint commands without an approval prompt. Ignored when javelin.autonomy is auto-edit or full.",
          "order": 5
        },
        "javelin.agentMaxSteps": {
          "type": "number",
          "default": 24,
          "description": "Maximum number of agent steps before it stops and reports back.",
          "order": 6
        },
        "javelin.agentLiveEditInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Apply the agent's edits through a real, visible editor so you watch the code change in place (instead of a silent disk write).",
          "order": 7
        },
        "javelin.agentAnimateEdits": {
          "type": "boolean",
          "default": true,
          "description": "Animate added lines so the agent's edits look like they are being typed into the editor. Turn off to snap edits in instantly.",
          "order": 8
        },
        "javelin.agentEditSpeedMs": {
          "type": "number",
          "default": 24,
          "description": "Delay in milliseconds between animated chunks when the agent types an edit. Lower is faster.",
          "order": 9
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}
